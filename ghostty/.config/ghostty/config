# Ghostty — minimal config. tmux owns sessions/splits/keybinds, so this is
# just renderer + font + colours. Matches oh-my-posh zen.json (Catppuccin Mocha).
#
# Rendering left at Ghostty stock defaults on purpose: every tuning knob tried
# on the work machine (alpha-blending, font-thicken, freetype hints) made it
# worse, not better. Don't re-add render hacks.

theme = Catppuccin Mocha
# Background matched to the work machine's terminal (#303446) — slightly lighter
# than Mocha's base.
background = #303446
# Rescue dim elements (line numbers, comments) by forcing a min text/bg contrast ratio.
minimum-contrast = 1.6

# Vivid ANSI palette lifted from the work machine's GNOME Terminal profile —
# Catppuccin's own palette is intentionally muted/pastel. This keeps Mocha's
# background/fg but makes ls/eza/nvim colours pop.
palette = 0=#171421
palette = 1=#c01c28
palette = 2=#26a269
palette = 3=#a2734c
palette = 4=#12488b
palette = 5=#a347ba
palette = 6=#2aa1b3
palette = 7=#d0cfcc
palette = 8=#5e5c64
palette = 9=#f66151
palette = 10=#33da7a
palette = 11=#e9ad0c
palette = 12=#2a7bde
palette = 13=#c061cb
palette = 14=#33c7de
palette = 15=#ffffff

# JetBrains Mono Nerd Font 16 — same font and size as the old iTerm profile.
# Plain variant (icons at natural width, as oh-my-posh powerline glyphs expect),
# not the "Nerd Font Mono" variant.
font-family = JetBrainsMono Nerd Font
font-size = 16
cursor-style = block

# Let programs write the system clipboard via OSC52 — pairs with tmux's
# set-clipboard on. Reads stay at the default (ask) so nothing in the terminal
# can read the clipboard without a prompt.
clipboard-write = allow

# macos-option-as-alt is left at its default on purpose: iTerm sent normal
# Option characters, so Option+3 etc. keep typing what they did before.

window-padding-x = 4
window-padding-y = 4
confirm-close-surface = false
